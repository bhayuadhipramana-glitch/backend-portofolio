# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Runtime -----------------------------------------------------------------
# "local" allows plain-http cookies. Any other value (staging, production)
# forces Secure cookies and requires CORS_ALLOWED_ORIGINS to be set.
APP_ENV=local
PORT=8080

# Set to "true" only when the API is reachable exclusively through Cloudflare
# Tunnel; it makes the API trust the CF-Connecting-IP header for the client IP.
TRUST_CLOUDFLARE_TUNNEL=false

# --- PostgreSQL (docker-compose + API) ---------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portofolio_db
# Host port (loopback only). Change it if 5432 is taken by a local PostgreSQL,
# and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
# Must use the same credentials as above.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/portofolio_db?sslmode=disable

# --- Valkey (L2 cache; docker-compose + API) ---------------------------------
# Host port (loopback only). Use the same port in VALKEY_ADDR.
VALKEY_PORT=6379
VALKEY_ADDR=127.0.0.1:6379

# --- NATS JetStream (F3 event ingest + F4 worker; docker-compose + API) -----
# Host port (loopback only). Use the same port in NATS_URL.
NATS_PORT=4222
NATS_URL=nats://127.0.0.1:4222

# --- GitHub OAuth (single admin) ---------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must equal the callback URL registered in the GitHub OAuth app.
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
# Numeric GitHub user id of the admin (https://api.github.com/users/<login>).
ADMIN_GITHUB_ID=

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins. Required when APP_ENV is not "local".
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: where to redirect the browser after a successful login.
# AUTH_SUCCESS_URL=http://localhost:3000/admin

# --- F9 contact outbox -------------------------------------------------------
# Optional: http(s) URL that receives each contact submission as a JSON POST
# (e.g. a Discord/Slack-compatible relay). Unset = log-only, nothing is sent.
# CONTACT_WEBHOOK_URL=
